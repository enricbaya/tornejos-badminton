msgstr "S'ha creat el torneig «%(name)s»."

#: tournaments/views.py:123
#, python-format
msgid "Tournament \"%(name)s\" has been updated."
msgstr "S'ha actualitzat el torneig «%(name)s»."

#: tournaments/views.py:145
msgid "You must type DELETE TOURNAMENT to confirm."
msgstr "Per confirmar has d'escriure DELETE TOURNAMENT."

#: tournaments/views.py:149
#, python-format
msgid "Tournament \"%(name)s\" has been deleted."
msgstr "S'ha eliminat el torneig «%(name)s»."

#: tournaments/views.py:300
#, python-format
msgid "The backup file is too large (max %(mb)d MB)."
msgstr "La còpia és massa gran (màxim %(mb)d MB)."

#: tournaments/views.py:309
msgid "The file could not be read as JSON."
msgstr "No s'ha pogut llegir el fitxer com a JSON."

#: tournaments/views.py:313 tournaments/views.py:317
msgid "Unknown backup format (version missing or incorrect)."
msgstr "Format de còpia desconegut (falta la versió o és incorrecta)."

#: tournaments/views.py:328
#, python-format
msgid "Import failed and was rolled back: %(err)s"
msgstr "La importació ha fallat i s'ha desfet: %(err)s"

#: tournaments/views.py:461
#, python-format
msgid ""
"Tournament \"%(name)s\" restored with %(divs)s divisions and %(matches)s "
"matches."
msgstr ""
"S'ha recuperat el torneig «%(name)s» amb %(divs)s categories i %(matches)s "
"partits."

#: tournaments/views.py:610
#, python-format
msgid "Division \"%(name)s\" has been created."
msgstr "S'ha creat la categoria «%(name)s»."

#: tournaments/views.py:638
#, python-format
msgid "Players in \"%(name)s\" have been updated."
msgstr "S'han actualitzat els jugadors de «%(name)s»."

#: tournaments/views.py:641
#, python-format
msgid "Teams in \"%(name)s\" have been updated."
msgstr "S'han actualitzat les parelles de «%(name)s»."

#: tournaments/views.py:670
#, python-format
msgid "Seeding for \"%(name)s\" has been saved."
msgstr "S'han desat els caps de sèrie de «%(name)s»."

#: tournaments/views.py:697
msgid "Day assignment saved."
msgstr "S'ha desat l'assignació de jornades."

#: tournaments/views.py:715
msgid "Group reassignment is only possible for divisions with several groups."
msgstr "Només es poden reassignar grups en categories amb diversos grups."

#: tournaments/views.py:719 tournaments/views.py:838 tournaments/views.py:1733
msgid "The schedule is locked and cannot be changed."
msgstr "L'horari està bloquejat i no es pot modificar."

#: tournaments/views.py:723
msgid "Cannot reassign groups – results have already been recorded."
msgstr "No es poden reassignar els grups: ja hi ha resultats entrats."

#: tournaments/views.py:731 tournaments/views.py:2013
#: tournaments/views.py:2041
msgid "Invalid data."
msgstr "Dades incorrectes."

#: tournaments/views.py:738
msgid "Groups do not contain exactly the right teams."
msgstr "Els grups no contenen exactament els participants correctes."

#: tournaments/views.py:758
#, python-format
msgid "Group assignment in \"%(name)s\" saved and match schedule regenerated."
msgstr ""
"S'han desat els grups de «%(name)s» i s'ha tornat a generar el programa."

#: tournaments/views.py:760
msgid "No matches generated."
msgstr "No s'ha generat cap partit."

#: tournaments/views.py:781
#, python-format
msgid "Division \"%(name)s\" has been deleted."
msgstr "S'ha eliminat la categoria «%(name)s»."

#: tournaments/views.py:785
msgid "division"
msgstr "la categoria"

#: tournaments/views.py:809
msgid ""
"The format can only be changed before the match programme is generated."
msgstr ""
"El format només es pot canviar abans de generar el programa de partits."

#: tournaments/views.py:820
#, python-format
msgid "Format of \"%(name)s\" updated. You can now generate the match programme."
msgstr ""
"S'ha canviat el format de «%(name)s». Ara ja pots generar el programa de "
"partits."

#: tournaments/views.py:879
#, python-format
msgid "Schedule generated: %(group)s group matches in %(gc)s groups."
msgstr "Programa generat: %(group)s partits de grup en %(gc)s grups."

#: tournaments/views.py:884
#, python-format
msgid ""
"Schedule generated: %(group)s group matches in %(gc)s groups + %(playoff)s "
"playoff matches (scheduled after group stage)."
msgstr ""
"Programa generat: %(group)s partits de grup en %(gc)s grups + %(playoff)s "
"partits de fase final (després de la fase de grups)."

#: tournaments/views.py:889
#, python-format
msgid ""
"Schedule generated with %(n)s matches (+ %(p)s bracket final matches "
"reserved)."
msgstr ""
"Programa generat amb %(n)s partits (+ %(p)s partits del quadre reservats)."

#: tournaments/views.py:892
#, python-format
msgid "Schedule generated with %(n)s matches."
msgstr "Programa generat amb %(n)s partits."

#: tournaments/views.py:922
msgid "Result saved."
msgstr "S'ha desat el resultat."

#: tournaments/views.py:969
msgid "Cannot start match: "
msgstr "No es pot començar el partit: "

#: tournaments/views.py:973
msgid "Please choose a court before starting the match."
msgstr "Tria una pista abans de començar el partit."

#: tournaments/views.py:977
#, python-format
msgid "Court %(court)s is already in use."
msgstr "La pista %(court)s ja està ocupada."

#: tournaments/views.py:983
#, python-format
msgid "Match #%(n)s is now in progress."
msgstr "El partit #%(n)s ha començat."

#: tournaments/views.py:1005
#, python-format
msgid "Match #%(n)s has been reset to pending."
msgstr "El partit #%(n)s torna a estar pendent."

#: tournaments/views.py:1036
#, python-format
msgid "Walk-over recorded – %(winner)s wins."
msgstr "S'ha registrat el WO: guanya %(winner)s."

#: tournaments/views.py:1072
#, python-format
msgid "Bracket match updated: %(t1)s vs %(t2)s."
msgstr "S'ha actualitzat el partit del quadre: %(t1)s contra %(t2)s."

#: tournaments/views.py:1735
msgid ""
"Configure at least one tournament day before generating the time schedule."
msgstr "Configura almenys una jornada abans de generar l'horari."

#: tournaments/views.py:1744
msgid "Warning: schedule may be incomplete despite forced run."
msgstr "Atenció: l'horari pot quedar incomplet."

#: tournaments/views.py:1748
#, python-format
msgid "Time schedule generated for %(n)s matches."
msgstr "S'ha generat l'horari per a %(n)s partits."

#: tournaments/views.py:1750
msgid "No matches to schedule. Generate match programmes for divisions first."
msgstr ""
"No hi ha partits per programar. Primer genera el programa de partits de les "
"categories."

#: tournaments/views.py:1770
msgid "The schedule is now locked."
msgstr "S'ha bloquejat l'horari."

#: tournaments/views.py:1772
msgid "The schedule is now unlocked."
msgstr "S'ha desbloquejat l'horari."

#: tournaments/views.py:1782
msgid "You must type RESET SCHEDULE to confirm."
msgstr "Per confirmar has d'escriure RESET SCHEDULE."

#: tournaments/views.py:1788
msgid "All matches deleted and match number counter reset."
msgstr "S'han eliminat tots els partits i s'ha reiniciat el comptador."

#: tournaments/views.py:1862
#, python-format
msgid "Day %(n)s"
msgstr "Jornada %(n)s"

#: tournaments/views.py:2003 tournaments/views.py:2035
#: tournaments/views.py:2057
msgid "The schedule is locked."
msgstr "L'horari està bloquejat."

#: tournaments/views.py:2096
#, python-format
msgid "Match numbers recalculated – %(n)s matches numbered from 1."
msgstr "S'han renumerat els partits: %(n)s partits numerats des de l'1."

#: tournaments/views.py:2186
#, python-format
msgid "Bracket labels rebuilt (%(n)s matches updated)."
msgstr "S'han refet les etiquetes del quadre (%(n)s partits actualitzats)."

#: tournaments/views.py:2263
#, python-format
msgid ""
"Match numbers sorted by schedule – %(n)s matches numbered from 1 (%(u)s "
"without time placed last)."
msgstr ""
"Partits renumerats segons l'horari: %(n)s partits des de l'1 (%(u)s sense "
"hora al final)."

#: tournaments/views.py:2265
#, python-format
msgid "Match numbers sorted by schedule – %(n)s matches numbered from 1."
msgstr "Partits renumerats segons l'horari: %(n)s partits des de l'1."

